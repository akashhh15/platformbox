# Example values for the prod environment.
# Copy to terraform.tfvars and fill in the real values. Never commit terraform.tfvars.

project             = "cloud-platform-in-a-box"
environment         = "prod"
aws_region          = "ap-south-1"
vpc_cidr            = "10.1.0.0/16"
cluster_version     = "1.31"
public_access_cidrs = [] # Set to your admin CIDRs.
budget_email        = "REPLACE_ME_EMAIL"
budget_limit_usd    = 200
rds_enabled         = true
tags                = {}
