{
  "uid": "platformbox-argocd",
  "title": "PlatformBox / Argo CD",
  "tags": ["platformbox", "argocd", "gitops"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Applications by sync status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "count by (sync_status) (argocd_app_info)",
          "legendFormat": "{{sync_status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Applications by health status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "count by (health_status) (argocd_app_info)",
          "legendFormat": "{{health_status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application state",
      "type": "table",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_info == 1",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Sync operations in 1h",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (increase(argocd_app_sync_total[1h]))",
          "legendFormat": "{{phase}}"
        }
      ]
    }
  ]
}
