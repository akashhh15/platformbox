{
  "uid": "platformbox-kyverno",
  "title": "PlatformBox / Kyverno policy results",
  "tags": ["platformbox", "kyverno", "policy"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Denied results by policy",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy_name) (increase(kyverno_validating_policy_results_total{result=\"fail\", policy_validation_mode=\"Deny\"}[5m]))",
          "legendFormat": "{{policy_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Results by mode and outcome",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy_validation_mode, result) (increase(kyverno_validating_policy_results_total[5m]))",
          "legendFormat": "{{policy_validation_mode}} / {{result}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 policy execution duration",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kyverno_validating_policy_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
